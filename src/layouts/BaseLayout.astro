---
import '../styles/global.css';
import ThemeToggle from '../components/ThemeToggle';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Personal Finance Fundamentals",
  description = "Simple explanations. Structured practice. Only what matters."
} = Astro.props;

const pathname = Astro.url.pathname;
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | Finance Fundamentals</title>
    <meta name="description" content={description} />
    <!-- Inline script to prevent Dark Mode FOUC -->
    <script is:inline>
      const theme = localStorage.getItem('theme');
      if (theme === 'dark' || (!theme && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }
    </script>
  </head>
  <body class="bg-white dark:bg-[#060B14] text-[#0F172A] dark:text-[#F8FAFC] min-h-screen flex flex-col font-sans transition-colors duration-200">
    <!-- Preparoo Clean Top Navigation Header -->
    <header class="bg-white/90 dark:bg-[#060B14]/90 backdrop-blur-md border-b border-slate-100 dark:border-slate-800/80 sticky top-0 z-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-8 py-4 flex items-center justify-between gap-6">

        <!-- Logo Brand -->
        <a href="/" class="group flex items-center gap-2.5 text-2xl font-black tracking-tight text-[#0F172A] dark:text-white">
          <div class="w-9 h-9 rounded-xl bg-[#0B172A] text-white flex items-center justify-center font-black text-lg shadow-sm group-hover:scale-105 transition-transform">
            🦘
          </div>
          <span>Finance<span class="font-extrabold text-[#0B172A] dark:text-white">Prep</span><sup class="text-xs font-bold text-slate-400">®</sup></span>
        </a>

        <!-- Center Nav Items -->
        <nav class="hidden md:flex items-center space-x-8 text-sm font-bold text-slate-700 dark:text-slate-200">
          <a
            href="/"
            class={pathname === '/' ? "text-[#0F172A] dark:text-white border-b-2 border-[#0F172A] dark:border-white pb-0.5" : "hover:text-[#0F172A] dark:hover:text-white transition-colors"}
          >
            Dashboard
          </a>
          <a
            href="/topics"
            class={pathname.startsWith('/topics') ? "text-[#0F172A] dark:text-white border-b-2 border-[#0F172A] dark:border-white pb-0.5" : "hover:text-[#0F172A] dark:hover:text-white transition-colors"}
          >
            Notes
          </a>
          <a
            href="/categories"
            class={pathname.startsWith('/categories') ? "text-[#0F172A] dark:text-white border-b-2 border-[#0F172A] dark:border-white pb-0.5" : "hover:text-[#0F172A] dark:hover:text-white transition-colors"}
          >
            Categories
          </a>
          <a
            href="/topics/time-value-of-money"
            class="hover:text-[#0F172A] dark:hover:text-white transition-colors flex items-center gap-1.5 text-xs uppercase font-extrabold px-3 py-1 rounded-full bg-emerald-50 dark:bg-emerald-950/60 text-emerald-700 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-900"
          >
            <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
            Time Value of Money
          </a>
        </nav>

        <!-- Right Side Actions -->
        <div class="flex items-center gap-3">
          <ThemeToggle client:load />

          <a
            href="/topics"
            class="hidden sm:inline-flex px-5 py-2.5 rounded-full bg-[#0B172A] hover:bg-[#1E293B] text-white text-xs font-bold transition-all shadow-sm hover:shadow"
          >
            Start Learning
          </a>
        </div>

      </div>
    </header>

    <main class="flex-grow max-w-7xl w-full mx-auto px-4 sm:px-8 py-8 md:py-12">
      <slot />
    </main>

    <footer class="bg-[#0B172A] text-slate-300 border-t border-slate-800 py-12 text-sm mt-16">
      <div class="max-w-7xl mx-auto px-4 sm:px-8 flex flex-col md:flex-row justify-between items-center gap-6">
        <div class="flex items-center gap-3">
          <div class="w-8 h-8 rounded-lg bg-white/10 text-white flex items-center justify-center font-bold text-sm">
            🦘
          </div>
          <span class="font-extrabold text-white text-base">FinancePrep<sup>®</sup></span>
          <span class="text-xs text-slate-400">Simple explanations. Structured practice. Only what matters.</span>
        </div>
        <div class="flex space-x-6 text-xs font-semibold text-slate-400">
          <a href="/" class="hover:text-white transition-colors">Dashboard</a>
          <a href="/topics" class="hover:text-white transition-colors">Notes</a>
          <a href="/categories" class="hover:text-white transition-colors">Categories</a>
        </div>
      </div>
    </footer>
  </body>
</html>

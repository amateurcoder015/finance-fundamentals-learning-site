---
import type { ResolvedExplainerRef } from '../../lib/explainer-refs';
import Section from '../ui/Section.astro';
import TimeValueOfMoney from '../../explainers/time-value-of-money/index';
import FuturesPricingExplainer from '../../explainers/futures-pricing/index';
import OptionsSuite from '../../explainers/options-suite/index';
import MarginLedger from '../../explainers/margin-ledger/index';

interface Props {
  refs: ResolvedExplainerRef[];
  currency?: string;
}
const { refs, currency = '$' } = Astro.props;

// To add an explainer: (1) add a registry entry in src/explainers/registry.ts, and
// (2) add its import above and an explicit branch in the chain below.
// Astro cannot hydrate a component chosen dynamically, and `client:visible` only hydrates React islands.
---
{refs.length > 0 && (
  <Section id="explainers" eyebrow="Try it yourself" title="Explore the numbers">
    <div class="space-y-10">
      {refs.map((ref) => {
        if (ref.name === 'time-value-of-money') return <TimeValueOfMoney client:visible view={ref.view} currency={currency} />;
        if (ref.name === 'futures-pricing') return <FuturesPricingExplainer client:visible view={ref.view} currency={currency} />;
        if (ref.name === 'options-suite') return <OptionsSuite client:visible view={ref.view} currency={currency} />;
        if (ref.name === 'margin-ledger') return <MarginLedger client:visible currency={currency} />;
        throw new Error(`[Content Validation Error] Explainer "${ref.name}" is registered but has no render branch in Explainers.astro`);
      })}
    </div>
  </Section>
)}

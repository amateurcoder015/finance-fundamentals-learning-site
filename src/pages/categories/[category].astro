---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { CATEGORIES } from '../../content/config';
import { getTopicSlug } from '../../utils/topic-loader';

export async function getStaticPaths() {
  const allTopics = await getCollection('topics');
  return CATEGORIES.map((category) => {
    const slug = category.toLowerCase().replace(/\s+/g, '-');
    const filteredTopics = allTopics.filter((t) => t.data.category === category);
    return {
      params: { category: slug },
      props: { categoryName: category, topics: filteredTopics },
    };
  });
}

const { categoryName, topics } = Astro.props;
---

<BaseLayout title={`${categoryName} — Finance Fundamentals`}>
  <div class="mb-10 border-b border-stone-200 dark:border-slate-800 pb-6">
    <div class="mb-3">
      <a href="/categories" class="text-xs uppercase font-extrabold tracking-wider text-[#1D4ED8] dark:text-blue-400 hover:underline">
        ← All Categories
      </a>
    </div>
    <h1 class="text-4xl md:text-5xl font-extrabold text-slate-900 dark:text-white tracking-tight mb-3">
      {categoryName}
    </h1>
    <p class="text-lg text-slate-600 dark:text-slate-300">
      Foundational concepts and practice materials in {categoryName} ({topics.length} {topics.length === 1 ? 'topic' : 'topics'}).
    </p>
  </div>

  {topics.length === 0 ? (
    <div class="p-12 text-center bg-white dark:bg-[#131B2E] border border-stone-200 dark:border-slate-800 rounded-xl">
      <p class="text-slate-600 dark:text-slate-400 mb-4">No topics added in {categoryName} yet.</p>
      <p class="text-sm text-slate-500 font-mono">Run `npm run new-topic` to create one!</p>
    </div>
  ) : (
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {topics.map((topic) => {
        const slug = getTopicSlug(topic);
        return (
          <a
            href={`/topics/${slug}`}
            class="group block bg-white dark:bg-[#131B2E] border border-stone-200 dark:border-slate-800 rounded-xl p-6 hover:-translate-y-0.5 hover:shadow-lg hover:border-blue-500/50 dark:hover:border-blue-500/50 transition-all duration-200 flex flex-col justify-between relative overflow-hidden"
          >
            <div class="absolute top-0 left-0 right-0 h-1 bg-blue-600 opacity-0 group-hover:opacity-100 transition-opacity"></div>

            <div>
              <div class="flex items-center justify-between gap-2 mb-3">
                <span class="text-xs uppercase font-extrabold tracking-wide px-2.5 py-1 rounded bg-[#1D4ED8]/10 text-[#1D4ED8] dark:text-blue-400">
                  {topic.data.category}
                </span>
                <span class:list={[
                  'text-xs font-semibold px-2.5 py-0.5 rounded-full capitalize',
                  topic.data.difficulty === 'beginner' && 'bg-emerald-50 dark:bg-emerald-950/60 text-emerald-700 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800/60',
                  topic.data.difficulty === 'intermediate' && 'bg-amber-50 dark:bg-amber-950/60 text-amber-700 dark:text-amber-300 border border-amber-200 dark:border-amber-800/60',
                  topic.data.difficulty === 'advanced' && 'bg-rose-50 dark:bg-rose-950/60 text-rose-700 dark:text-rose-300 border border-rose-200 dark:border-rose-800/60',
                ]}>
                  {topic.data.difficulty}
                </span>
              </div>

              <h2 class="text-xl font-bold text-slate-900 dark:text-slate-100 mb-2 group-hover:text-[#1D4ED8] dark:group-hover:text-blue-400 transition-colors">
                {topic.data.title}
              </h2>

              <p class="text-sm text-slate-600 dark:text-slate-400 leading-relaxed line-clamp-3 mb-6">
                {topic.data.description}
              </p>
            </div>

            <div class="text-xs text-slate-400 dark:text-slate-500 border-t border-stone-100 dark:border-slate-800/80 pt-4 flex justify-between items-center font-medium">
              <span>Added {new Date(topic.data.dateAdded).toLocaleDateString()}</span>
              <span class="font-bold text-[#1D4ED8] dark:text-blue-400 flex items-center gap-1 group-hover:translate-x-0.5 transition-transform">
                <span>View Topic</span>
                <span>→</span>
              </span>
            </div>
          </a>
        );
      })}
    </div>
  )}
</BaseLayout>

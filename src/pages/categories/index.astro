---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { CATEGORIES } from '../../content/config';

const allTopics = await getCollection('topics');

const categoryCounts = CATEGORIES.map((category) => {
  const count = allTopics.filter((t) => t.data.category === category).length;
  const slug = category.toLowerCase().replace(/\s+/g, '-');
  return {
    category,
    slug,
    count,
  };
});

const categoryIcons: Record<string, string> = {
  "Corporate Finance": "🏢",
  "Financial Statements": "📊",
  "Equities": "📈",
  "Fixed Income": "📜",
  "Derivatives": "🔀",
  "Portfolio Management": "💼",
  "Economics": "🌐",
  "Alternative Investments": "💎",
};
---

<BaseLayout title="Categories — Personal Finance Fundamentals">
  <div class="mb-10 border-b border-stone-200 dark:border-slate-800 pb-6">
    <h1 class="text-4xl md:text-5xl font-extrabold text-slate-900 dark:text-white tracking-tight mb-3">
      Finance Categories
    </h1>
    <p class="text-lg text-slate-600 dark:text-slate-300">
      Explore topics grouped by core financial domain.
    </p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    {categoryCounts.map((cat) => (
      <a
        href={`/categories/${cat.slug}`}
        class="group block bg-white dark:bg-[#131B2E] border border-stone-200 dark:border-slate-800 rounded-xl p-6 hover:-translate-y-0.5 hover:shadow-lg hover:border-blue-500/50 dark:hover:border-blue-500/50 transition-all duration-200 flex flex-col justify-between"
      >
        <div>
          <div class="text-3xl mb-4">{categoryIcons[cat.category] || "📁"}</div>
          <h2 class="text-xl font-bold text-slate-900 dark:text-slate-100 mb-2 group-hover:text-[#1D4ED8] dark:group-hover:text-blue-400 transition-colors">
            {cat.category}
          </h2>
          <p class="text-sm text-slate-500 dark:text-slate-400 mb-6 font-medium">
            {cat.count === 1 ? '1 Topic Available' : `${cat.count} Topics Available`}
          </p>
        </div>
        <span class="text-xs uppercase font-extrabold tracking-wider text-[#1D4ED8] dark:text-blue-400 flex items-center gap-1 group-hover:translate-x-0.5 transition-transform">
          <span>Browse Category</span>
          <span>→</span>
        </span>
      </a>
    ))}
  </div>
</BaseLayout>

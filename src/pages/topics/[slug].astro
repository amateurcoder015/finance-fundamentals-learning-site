---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { loadTopicAuxiliaryData, getTopicSlug } from '../../utils/topic-loader';
import MermaidDiagram from '../../components/MermaidDiagram';
import PayoffChart from '../../components/PayoffChart';
import Quiz from '../../components/Quiz';
import Flashcards from '../../components/Flashcards';
import { HeroMotion, HeroItem } from '../../components/HeroMotion';
import { ScrollReveal } from '../../components/ScrollReveal';

export async function getStaticPaths() {
  const topics = await getCollection('topics');
  return topics.map((topic, index) => {
    const slug = getTopicSlug(topic);
    const nextTopic = topics[(index + 1) % topics.length];
    return {
      params: { slug },
      props: { topic, slug, nextTopic },
    };
  });
}

const { topic, slug, nextTopic } = Astro.props;
const { Content } = await topic.render();
const auxiliary = loadTopicAuxiliaryData(slug);

const formattedDate = new Date(topic.data.dateAdded).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
});

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "LearningResource",
  "name": topic.data.title,
  "description": topic.data.description,
  "educationalLevel": topic.data.difficulty,
  "learningResourceType": "Study Note & Practice Quiz",
  "datePublished": topic.data.dateAdded,
  "author": {
    "@type": "Organization",
    "name": "Finance Fundamentals"
  }
};
---

<BaseLayout title={topic.data.title} description={topic.data.description} article={true}>
  <!-- JSON-LD Structured Data -->
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <!-- Breadcrumbs Navigation -->
  <nav class="flex items-center space-x-2 text-xs font-semibold text-slate-500 dark:text-slate-400 mb-6 overflow-x-auto no-scrollbar" aria-label="Breadcrumb">
    <a href="/" class="hover:text-[#0F172A] dark:hover:text-white transition-colors">Dashboard</a>
    <span>/</span>
    <a href={`/categories/${topic.data.category.toLowerCase().replace(/\s+/g, '-')}`} class="hover:text-[#0F172A] dark:hover:text-white transition-colors">
      {topic.data.category}
    </a>
    <span>/</span>
    <span class="text-[#0F172A] dark:text-white font-bold truncate">{topic.data.title}</span>
  </nav>

  <!-- Staggered Header Zone -->
  <HeroMotion client:load>
    <div class="mb-10 pb-8 border-b border-slate-200 dark:border-slate-800">

      <!-- Domain Badges & Metadata -->
      <HeroItem>
        <div class="flex flex-wrap items-center gap-3 mb-4">
          <a
            href={`/categories/${topic.data.category.toLowerCase().replace(/\s+/g, '-')}`}
            class="text-xs font-black uppercase tracking-wider px-3.5 py-1.5 rounded-full bg-[#0F172A] text-white dark:bg-blue-950 dark:text-blue-300 shadow-sm"
          >
            {topic.data.category}
          </a>
          <span class="text-xs font-bold px-3 py-1 rounded-full bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 capitalize">
            Level: {topic.data.difficulty}
          </span>
          <span class="text-xs text-slate-400 font-semibold">
            Added {formattedDate}
          </span>
        </div>
      </HeroItem>

      <!-- Page Title (single H1) -->
      <HeroItem>
        <h1 class="text-4xl sm:text-5xl md:text-6xl font-black tracking-tight text-[#0F172A] dark:text-white mb-4 leading-tight">
          {topic.data.title}
        </h1>
      </HeroItem>

      <!-- Subtitle Description -->
      <HeroItem>
        <p class="text-lg md:text-xl text-slate-600 dark:text-slate-300 max-w-3xl leading-relaxed mb-6 font-medium">
          {topic.data.description}
        </p>
      </HeroItem>

      <!-- Tag Pills -->
      <HeroItem>
        <div class="flex flex-wrap gap-2 pt-1">
          {topic.data.tags.map((tag) => (
            <span class="text-xs font-mono bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400 px-3 py-1 rounded-full border border-slate-200 dark:border-slate-700">
              #{tag}
            </span>
          ))}
        </div>
      </HeroItem>
    </div>
  </HeroMotion>

  <div class="space-y-16">
    <!-- Section 1: Note content (MDX inside styled prose container) -->
    <ScrollReveal client:load>
      <section class="bg-white dark:bg-[#0F1E36] p-6 sm:p-10 md:p-14 rounded-3xl border border-slate-200 dark:border-slate-800 shadow-sm">
        <div class="prose dark:prose-invert max-w-prose mx-auto">
          <Content />
        </div>
      </section>
    </ScrollReveal>

    <!-- Section 2: Visual Concept Model Card (Payoff Chart or Mermaid Diagram) -->
    {auxiliary.payoffChart ? (
      <ScrollReveal client:load>
        <section class="bg-white dark:bg-[#0F1E36] p-6 sm:p-8 md:p-10 rounded-3xl border border-slate-200 dark:border-slate-800 shadow-sm">
          <PayoffChart
            client:load
            positions={auxiliary.payoffChart.positions}
            priceRange={auxiliary.payoffChart.priceRange}
            title={auxiliary.payoffChart.title}
            description={auxiliary.payoffChart.description}
          />
        </section>
      </ScrollReveal>
    ) : (
      <ScrollReveal client:load>
        <section class="bg-white dark:bg-[#0F1E36] p-6 sm:p-8 md:p-10 rounded-3xl border border-slate-200 dark:border-slate-800 shadow-sm">
          <div class="flex items-center justify-between mb-6 pb-4 border-b border-slate-200 dark:border-slate-800">
            <div>
              <span class="text-xs uppercase font-black tracking-widest text-slate-400 dark:text-slate-400">
                Visual Model
              </span>
              <h2 class="text-2xl font-black text-[#0F172A] dark:text-white tracking-tight">Concept Diagram</h2>
            </div>
            <span class="text-xs font-mono bg-slate-100 dark:bg-slate-800 text-slate-500 px-3 py-1 rounded-full">SVG Model</span>
          </div>
          <MermaidDiagram client:load code={auxiliary.diagram} />
        </section>
      </ScrollReveal>
    )}


    <!-- Practice Divider -->
    <ScrollReveal client:load>
      <div class="relative flex py-4 items-center">
        <div class="flex-grow border-t border-slate-200 dark:border-slate-800"></div>
        <span class="flex-shrink mx-4 px-6 py-2 rounded-full bg-[#0F172A] dark:bg-white text-white dark:text-[#0F172A] font-black text-xs uppercase tracking-widest shadow-md">
          Structured Practice & Mastery
        </span>
        <div class="flex-grow border-t border-slate-200 dark:border-slate-800"></div>
      </div>
    </ScrollReveal>

    <!-- Section 3: Interactive Flashcards Widget -->
    <ScrollReveal client:load>
      <section class="space-y-4">
        <div class="flex items-center gap-3 px-1">
          <span class="text-2xl" aria-hidden="true">📇</span>
          <div>
            <h2 class="text-2xl font-black text-[#0F172A] dark:text-white tracking-tight">Flashcard Deck</h2>
            <p class="text-xs text-slate-500 font-medium">Stuff you actually need to remember</p>
          </div>
        </div>
        <Flashcards client:load cards={auxiliary.flashcards} />
      </section>
    </ScrollReveal>

    <!-- Section 4: Interactive Quiz Widget -->
    <ScrollReveal client:load>
      <section class="space-y-4">
        <div class="flex items-center gap-3 px-1">
          <span class="text-2xl" aria-hidden="true">📝</span>
          <div>
            <h2 class="text-2xl font-black text-[#0F172A] dark:text-white tracking-tight">Question Bank & Quiz</h2>
            <p class="text-xs text-slate-500 font-medium">Practice what's likely to show up on exam day</p>
          </div>
        </div>
        <Quiz client:load questions={auxiliary.quiz} />
      </section>
    </ScrollReveal>

    <!-- Bottom Navigation Scaffold (Back to all topics / Next topic) -->
    <ScrollReveal client:load>
      <div class="pt-8 border-t border-slate-200 dark:border-slate-800 flex flex-col sm:flex-row justify-between items-center gap-4">
        <a
          href="/topics"
          class="min-h-[44px] inline-flex items-center px-6 py-2.5 rounded-full bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-200 text-xs font-bold transition-all"
        >
          ← Back to All Topics
        </a>
        {nextTopic && (
          <a
            href={`/topics/${getTopicSlug(nextTopic)}`}
            class="min-h-[44px] inline-flex items-center px-6 py-2.5 rounded-full bg-[#0F172A] dark:bg-white text-white dark:text-[#0F172A] text-xs font-bold transition-all shadow-sm hover:scale-[1.02]"
          >
            <span>Next: {nextTopic.data.title}</span>
            <span class="ml-1">→</span>
          </a>
        )}
      </div>
    </ScrollReveal>
  </div>
</BaseLayout>

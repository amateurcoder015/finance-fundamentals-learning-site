---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404 — Page Not Found" description="The page you requested could not be found on Finance Fundamentals.">
  <div class="min-h-[60vh] flex flex-col justify-center items-center text-center px-4">
    <div class="w-16 h-16 rounded-2xl bg-[#0F172A] dark:bg-white text-white dark:text-[#0F172A] font-black text-2xl flex items-center justify-center mb-6 shadow-lg">
      404
    </div>
    <h1 class="text-4xl sm:text-5xl font-black text-[#0F172A] dark:text-white tracking-tight mb-4">
      Topic or Page Not Found
    </h1>
    <p class="text-slate-600 dark:text-slate-400 font-medium text-base md:text-lg max-w-md mb-8 leading-relaxed">
      The financial concept or route you requested doesn't exist or has moved. Return to the dashboard to keep learning.
    </p>

    <div class="flex flex-wrap justify-center gap-4">
      <a
        href="/"
        class="px-6 py-3 rounded-full bg-[#0F172A] hover:bg-[#1E293B] dark:bg-white dark:text-[#0F172A] text-white font-bold text-sm shadow-md transition-all hover:scale-[1.02]"
      >
        ← Back to Dashboard
      </a>
      <a
        href="/topics"
        class="px-6 py-3 rounded-full bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:text-slate-200 text-slate-700 font-bold text-sm transition-all"
      >
        Browse All Notes
      </a>
    </div>
  </div>
</BaseLayout>

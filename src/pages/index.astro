---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { CATEGORIES } from '../content/config';
import { getTopicSlug } from '../utils/topic-loader';
import { HeroMotion, HeroItem } from '../components/HeroMotion';
import { ScrollReveal, ScrollItem } from '../components/ScrollReveal';
import InteractiveFlashcardsPreview from '../components/InteractiveFlashcardsPreview';

const allTopics = await getCollection('topics');

const topicsByCategory = CATEGORIES.map((category) => {
  const sortedTopics = allTopics
    .filter((t) => t.data.category === category)
    .sort((a, b) => new Date(a.data.dateAdded).getTime() - new Date(b.data.dateAdded).getTime());

  return {
    category,
    totalCount: sortedTopics.length,
    topics: sortedTopics.slice(0, 3),
  };
}).filter((group) => group.totalCount > 0);

const categoryIcons: Record<string, string> = {
  "Corporate Finance": "🏢",
  "Financial Statements": "📊",
  "Equities": "📈",
  "Fixed Income": "📜",
  "Derivatives": "🔀",
  "Portfolio Management": "💼",
  "Economics": "🌐",
  "Alternative Investments": "💎",
};
---

<BaseLayout title="Make Finance Feel Simple — Finance Fundamentals">

  <!-- Staggered Entrance Hero Section -->
  <HeroMotion client:load>
    <div class="flex flex-col items-center text-center pt-4 pb-8 md:py-10">

      <!-- Display Headline -->
      <HeroItem client:load>
        <h1 class="text-6xl sm:text-7xl md:text-8xl lg:text-[104px] font-black tracking-tighter text-[#0F172A] dark:text-white leading-[0.98] max-w-5xl mb-6">
          Make Finance feel simple
        </h1>
      </HeroItem>

      <!-- Category Filter Pills Row -->
      <HeroItem client:load>
        <div class="flex flex-wrap justify-center items-center gap-2 md:gap-3 mb-6">
          <span class="px-6 py-2.5 rounded-full bg-[#0F172A] dark:bg-white text-white dark:text-[#0F172A] text-xs font-extrabold shadow-md">
            All Domains
          </span>
          {CATEGORIES.map((cat) => (
            <a
              href={`/categories/${cat.toLowerCase().replace(/\s+/g, '-')}`}
              class="px-5 py-2.5 rounded-full bg-slate-100 dark:bg-slate-800/80 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-200 text-xs font-bold transition-all hover:scale-[1.02]"
            >
              {cat}
            </a>
          ))}
        </div>
      </HeroItem>

      <!-- Subtitle -->
      <HeroItem client:load>
        <p class="text-lg md:text-xl text-slate-600 dark:text-slate-400 font-medium max-w-2xl">
          Simple explanations. Structured practice. Only what matters.
        </p>
      </HeroItem>

    </div>
  </HeroMotion>

  <!-- Interactive 3D Showcase Sandbox Island -->
  <InteractiveFlashcardsPreview client:load />

  <!-- Scroll-Triggered Topics Grid Section -->
  <div class="my-16 space-y-16">

    <ScrollReveal client:load className="text-center max-w-2xl mx-auto mb-10">
      <h2 class="text-3xl md:text-4xl font-extrabold text-[#0F172A] dark:text-white tracking-tight mb-3">
        Structured Learning Notes
      </h2>
      <p class="text-slate-600 dark:text-slate-400 font-medium text-base">
        Deep dives into foundational topics across 8 core financial disciplines.
      </p>
    </ScrollReveal>

    {topicsByCategory.map((group) => (
      <section class="space-y-6">
        <ScrollReveal client:load className="flex justify-between items-end border-b border-slate-200 dark:border-slate-800 pb-4">
          <div class="flex items-center gap-3">
            <span class="text-3xl">{categoryIcons[group.category] || "📁"}</span>
            <div>
              <h3 class="text-2xl font-black text-[#0F172A] dark:text-white tracking-tight">{group.category}</h3>
              <p class="text-xs text-slate-500 font-medium">Core Financial Fundamentals</p>
            </div>
          </div>
          <a
            href={`/categories/${group.category.toLowerCase().replace(/\s+/g, '-')}`}
            class="text-xs uppercase font-extrabold tracking-wider text-[#0F172A] dark:text-white hover:underline flex items-center gap-1"
          >
            <span>Browse Category ({group.totalCount})</span>
            <span>→</span>
          </a>
        </ScrollReveal>

        <ScrollReveal client:load stagger className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {group.topics.map((topic) => {
            const slug = getTopicSlug(topic);
            return (
              <ScrollItem client:load>
                <a
                  href={`/topics/${slug}`}
                  class="group block bg-white dark:bg-[#0F1E36] border border-slate-200 dark:border-slate-800/80 rounded-2xl p-7 hover:-translate-y-1.5 hover:shadow-2xl hover:border-[#0F172A] dark:hover:border-blue-500/60 transition-all duration-200 flex flex-col justify-between"
                >
                  <div>
                    <div class="flex items-center justify-between gap-2 mb-4">
                      <span class="text-xs font-black uppercase tracking-wider px-3 py-1 rounded-full bg-[#0F172A] text-white dark:bg-blue-950 dark:text-blue-300">
                        {topic.data.category}
                      </span>
                      <span class="text-xs font-bold px-2.5 py-0.5 rounded-full bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 capitalize">
                        {topic.data.difficulty}
                      </span>
                    </div>

                    <h4 class="text-2xl font-black text-[#0F172A] dark:text-white mb-3 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors tracking-tight">
                      {topic.data.title}
                    </h4>

                    <p class="text-sm text-slate-600 dark:text-slate-300 leading-relaxed line-clamp-3 mb-6">
                      {topic.data.description}
                    </p>
                  </div>

                  <div class="text-xs text-slate-400 dark:text-slate-400 border-t border-slate-100 dark:border-slate-800 pt-4 flex justify-between items-center font-bold">
                    <span>Added {new Date(topic.data.dateAdded).toLocaleDateString()}</span>
                    <span class="text-[#0F172A] dark:text-blue-400 flex items-center gap-1 group-hover:translate-x-1 transition-transform">
                      <span>Study Note</span>
                      <span>→</span>
                    </span>
                  </div>
                </a>
              </ScrollItem>
            );
          })}
        </ScrollReveal>
      </section>
    ))}

  </div>
</BaseLayout>

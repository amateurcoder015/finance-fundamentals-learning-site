graph TD
    Y["Bond Yield and Spread Measures"] --> YM["Yield Measures"]
    Y --> SP["Yield Spreads"]

    YM --> YTM["Yield to Maturity<br/>(IRR of promised cash flows)"]
    YTM --> ASM["Assumes: hold to maturity,<br/>no default, reinvest at YTM"]
    YTM --> CAL["Calendar Adjustments"]
    CAL --> ST["Street Convention<br/>(scheduled dates)"]
    CAL --> TR["True Yield<br/>(next business day, slightly lower)"]
    CAL --> GEY["Government Equivalent Yield<br/>(30/360 yield x 365/360)"]
    YM --> INC["Income-Based Measures"]
    INC --> CY["Current Yield<br/>(Annual Coupon / Flat Price)"]
    INC --> SY["Simple Yield<br/>(Coupon + Straight-Line Amortization) / Price"]
    YM --> OPT["Embedded Options"]
    OPT --> YTC["Yield to Call / Put<br/>(at each exercise date)"]
    YTC --> YTW["Yield to Worst<br/>(Lowest of YTM and all YTC)"]

    SP --> BEN["Spread = Bond Yield - Benchmark Yield<br/>(in basis points)"]
    BEN --> G["G-Spread<br/>(vs interpolated government yield)"]
    BEN --> I["I-Spread<br/>(vs interpolated swap rate)"]
    BEN --> Z["Z-Spread<br/>(constant spread over spot curve)"]
    Z --> OAS["OAS = Z-Spread - Option Value<br/>(callable)"]
    Z --> OAS2["OAS = Z-Spread + Option Value<br/>(putable)"]
    Z --> OAS3["OAS = Z-Spread<br/>(option-free)"]
